{
  // Editor / formatting
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": true
  },

  // Common excludes for test projects
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
    "**/venv": true,
    "**/node_modules": true,
    "**/.DS_Store": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.pytest_cache": true
  },

  // Terminal environment: include a local "drivers" folder in PATH so browsers drivers are found
  "terminal.integrated.env.windows": {
    "PATH": "${env:PATH};${workspaceFolder}/drivers"
  },
  "terminal.integrated.env.linux": {
    "PATH": "${env:PATH}:${workspaceFolder}/drivers"
  },
  "terminal.integrated.env.osx": {
    "PATH": "${env:PATH}:${workspaceFolder}/drivers"
  },

  // Python-specific settings (adjust to your formatter/linter preferences)
  "python.envFile": "${workspaceFolder}/.env",
  "python.pythonPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],
  "python.formatting.provider": "black",
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // JavaScript / Node settings for test runners & linting
  "eslint.enable": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript"],
  "prettier.requireConfig": true,
  "mochaExplorer.files": "test/**/*.spec.js",

  // Debug convenience (auto attach Node when debugging JS tests)
  "debug.node.autoAttach": "on",

  // Optional: make VS Code's Test Explorer less noisy (toggle auto runs)
  "testing.autoRun": { "watch": false },

  // Optional: set default terminal to your preferred shell
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.defaultProfile.osx": "zsh"
}